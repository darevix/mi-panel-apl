{
  "type": "APL",
  "version": "1.4",
  "theme": "dark",
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "Frame",
        "width": "100%",
        "height": "100%",
        "backgroundColor": "#0B1016",
        "items": [
          {
            "type": "Container",
            "width": "100%",
            "height": "100%",
            "paddingLeft": "5vw",
            "paddingRight": "5vw",
            "paddingTop": "5vh",
            "paddingBottom": "4vh",
            "direction": "row",
            "items": [
              {
                "type": "Container",
                "width": "40%",
                "height": "100%",
                "items": [
                  {
                    "type": "Text",
                    "text": "{{payload.saludo}}",
                    "fontSize": "3vh",
                    "color": "#8FB3C7"
                  },
                  {
                    "type": "Text",
                    "text": "{{payload.fecha}}",
                    "fontSize": "4.8vh",
                    "fontWeight": "bold",
                    "color": "#FFFFFF",
                    "paddingTop": "0.5vh"
                  },
                  {
                    "type": "Text",
                    "text": "{{payload.clima}}",
                    "fontSize": "3vh",
                    "color": "#7FD1E0",
                    "paddingTop": "3vh"
                  },
                  {
                    "type": "Text",
                    "text": "{{payload.frase}}",
                    "fontSize": "2.5vh",
                    "color": "#93A4B3",
                    "fontStyle": "italic",
                    "paddingTop": "6vh"
                  }
                ]
              },
              {
                "type": "Container",
                "width": "60%",
                "height": "100%",
                "paddingLeft": "4vw",
                "items": [
                  {
                    "type": "Text",
                    "text": "AGENDA",
                    "fontSize": "2.2vh",
                    "color": "#6E8496"
                  },
                  {
                    "type": "Text",
                    "text": "{{payload.agendaTexto}}",
                    "fontSize": "3vh",
                    "color": "#E6EDF3",
                    "paddingTop": "1vh"
                  },
                  {
                    "type": "Text",
                    "text": "PLAN DE HOY",
                    "fontSize": "2.2vh",
                    "color": "#6E8496",
                    "paddingTop": "3vh"
                  },
                  {
                    "type": "Text",
                    "text": "{{payload.planTexto}}",
                    "fontSize": "3vh",
                    "color": "#E6EDF3",
                    "paddingTop": "1vh"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
